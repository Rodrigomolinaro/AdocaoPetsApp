<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdocaoPetsApp.Views.EditarPetPage"
             Title="Editar Pet">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">
            <Label Text="Atualizar Dados do Animal" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

            <Entry x:Name="NomeEntry" Placeholder="Nome do Pet" />
            <Entry x:Name="EspecieEntry" Placeholder="Espécie (Ex: Cachorro, Gato)" />
            <Entry x:Name="RacaEntry" Placeholder="Raça" />
            <Entry x:Name="IdadeEntry" Placeholder="Idade (em meses ou anos)" Keyboard="Numeric" />
            <Entry x:Name="ImagemUrlEntry" Placeholder="Link da Foto do Pet (URL)" />
            <Entry x:Name="PorteEntry" Placeholder="Porte (Ex: Pequeno, Médio, Grande)" />
            <Entry x:Name="SexoEntry" Placeholder="Sexo (Ex: Macho / Fêmea)" />
            <Entry x:Name="CorEntry" Placeholder="Cor predominante" />
            <Entry x:Name="DescricaoEntry" Placeholder="Descrição ou observações" />

            <Button Text="Salvar Alterações" 
                    Clicked="OnSalvarClicked" 
                    BackgroundColor="#2B0B98" 
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0, 20, 0, 0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>