<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdocaoPetsApp.Views.GerenciarPetsPage"
             Title="Gerir Meus Pets">

    <Grid Padding="15">
        <CollectionView x:Name="PetsCollectionView">
            <CollectionView.EmptyView>
                <Label Text="Você ainda não cadastrou nenhum pet." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       FontSize="16" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,15" Padding="15" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="True">
                        <StackLayout>
                            <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="#2B0B98"/>
                            <Label Text="{Binding Especie, StringFormat='Espécie: {0}'}" FontSize="14" TextColor="#555"/>
                            <Label Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="14" TextColor="Gray"/>

                            <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                                <!-- Botões com a referência ao Pet exato daquele cartão -->
                                <Button Text="Editar" 
                                        BackgroundColor="#ffc107" 
                                        TextColor="Black" 
                                        CommandParameter="{Binding .}" 
                                        Clicked="OnEditarClicked" 
                                        HorizontalOptions="FillAndExpand"/>

                                <Button Text="Excluir" 
                                        BackgroundColor="#dc3545" 
                                        TextColor="White" 
                                        CommandParameter="{Binding .}" 
                                        Clicked="OnExcluirClicked" 
                                        HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>