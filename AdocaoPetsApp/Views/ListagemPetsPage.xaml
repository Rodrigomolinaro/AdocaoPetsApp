<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdocaoPetsApp.Views.ListagemPetsPage"
             Title="Pets Cadastrados">

    <VerticalStackLayout Padding="20">
        <Label Text="Animais Disponíveis" FontSize="22" FontAttributes="Bold" Margin="0,0,0,15" HorizontalOptions="Center" />

        <CollectionView x:Name="PetsCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5,0,5" Padding="15" CornerRadius="8" BorderColor="LightGray" HasShadow="True">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nome}" FontSize="18" FontAttributes="Bold" TextColor="#2B0B98"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Espécie:" FontAttributes="Bold"/>
                                <Label Text="{Binding Especie}" />
                                <Label Text=" | Raça:" FontAttributes="Bold" Margin="10,0,0,0"/>
                                <Label Text="{Binding Raca}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Nenhum pet encontrado no banco de dados." 
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="20"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>