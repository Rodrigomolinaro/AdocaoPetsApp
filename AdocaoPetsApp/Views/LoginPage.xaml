<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdocaoPetsApp.Views.LoginPage"
             Title="Bem-vindo(a)!">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="🐾 Adote um Pet" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#2c3e50"
                   Margin="0, 0, 0, 40"/>

            <Entry x:Name="EmailOuDocumentoEntry" 
                   Placeholder="E-mail, CPF ou CNPJ" 
                   Keyboard="Default" 
                   ClearButtonVisibility="WhileEditing"/>

            <Entry x:Name="SenhaEntry" 
                   Placeholder="Digite a sua senha" 
                   IsPassword="True" 
                   ClearButtonVisibility="WhileEditing"/>

            <Button Text="Entrar" 
                    Clicked="OnLoginClicked" 
                    BackgroundColor="#5cb85c" 
                    TextColor="White" 
                    CornerRadius="8"
                    Margin="0, 20, 0, 0"/>

            <!-- Botões de navegação para os cadastros previstos na Sprint 1 -->
            <Button Text="Quero adotar (Cadastro Pessoa Física)" 
                    Clicked="OnIrParaCadastroAdotanteClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="#007bff" 
                    CornerRadius="8"/>

            <Button Text="Sou uma ONG (Cadastro Instituição)" 
                    Clicked="OnIrParaCadastroOngClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="#e67e22" 
                    CornerRadius="8"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>