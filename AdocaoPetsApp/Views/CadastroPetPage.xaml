<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdocaoPetsApp.Views.CadastroPetPage"
             Title="Cadastrar Novo Pet">

    <!-- Adicionamos o ScrollView para permitir deslizar o ecrã para baixo -->
    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- O seu botão agora vai aparecer quando fizer scroll! -->
            <Button Text="Ver Pedidos de Adoção" 
        Clicked="OnVerPedidosClicked" 
        BackgroundColor="#007bff" 
        TextColor="White" 
        Margin="0,10,0,0"/>
            
            <Label Text="Dados do Animal" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

            <Entry x:Name="NomeEntry" Placeholder="Nome do Pet" />
            <Entry x:Name="EspecieEntry" Placeholder="Espécie (Ex: Cachorro, Gato)" />
            <Entry x:Name="RacaEntry" Placeholder="Raça" />
            <Entry x:Name="IdadeEntry" Placeholder="Idade (em meses ou anos)" Keyboard="Numeric" />
            <Entry x:Name="ImagemUrlEntry" Placeholder="Link da Foto do Pet (URL)" Margin="0,0,0,20" />
            <Entry x:Name="PorteEntry" Placeholder="Porte (Ex: Pequeno, Médio, Grande)" Margin="0,0,0,15" />
            <Entry x:Name="SexoEntry" Placeholder="Sexo (Ex: Macho / Fêmea)" Margin="0,0,0,15" />
            <Entry x:Name="CorEntry" Placeholder="Cor predominante" Margin="0,0,0,15" />
            <Entry x:Name="DescricaoEntry" Placeholder="Descrição ou observações" Margin="0,0,0,15" />

            <Button Text="Salvar Pet" 
                    Clicked="OnSalvarClicked" 
                    BackgroundColor="#2B0B98" 
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0, 20, 0, 0"/>

            <Button Text="Ver Pets Cadastrados" 
                    Clicked="OnVerPetsClicked" 
                    BackgroundColor="#E0E0E0" 
                    TextColor="Black"
                    CornerRadius="8"
                    Margin="0, 10, 0, 0"/>

            

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>