<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdocaoPetsApp.Views.GerenciarPetsPage"
             Title="Gerir Meus Pets">

    <Grid Padding="15">
        <CollectionView x:Name="PetsCollectionView">
            <CollectionView.EmptyView>
                <Label Text="Você ainda não cadastrou nenhum pet." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       FontSize="16" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,15" Padding="15" Stroke="#E0E0E0" BackgroundColor="#FFFFFF">
                        <!-- Arredondamento das bordas no padrão Border do MAUI -->
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="#2B0B98"/>
                            <Label Text="{Binding Status}" FontAttributes="Italic" FontSize="13" TextColor="#666"/>
                            <Label Text="{Binding Especie}" FontSize="14" TextColor="#555"/>
                            <Label Text="{Binding Raca}" FontSize="14" TextColor="#555"/>
                            <Label Text="{Binding Porte}" FontSize="12" TextColor="#777"/>
                            <Label Text="{Binding Sexo}" FontSize="12" TextColor="#777"/>
                            <Label Text="{Binding Cor}" FontSize="12" TextColor="#777"/>
                            <Label Text="{Binding Descricao}" FontSize="12" TextColor="#666" Margin="0,5,0,5"/>

                            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                <Button Text="Editar" BackgroundColor="#ffc107" TextColor="Black" CommandParameter="{Binding .}" Clicked="OnEditarClicked"/>
                                <Button Text="Excluir" BackgroundColor="#dc3545" TextColor="White" CommandParameter="{Binding .}" Clicked="OnExcluirClicked"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>