<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdocaoPetsApp.Views.LoginPage"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Image Source="dotnet_bot.png" HeightRequest="150" HorizontalOptions="Center" />

            <Label Text="Sistema de Adoção de Pets" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20"/>

            <Entry x:Name="EmailOuDocumentoEntry" Placeholder="CPF, CNPJ ou E-mail" />

            <Entry x:Name="SenhaEntry" Placeholder="Senha" IsPassword="True" />

            <Button Text="Entrar" 
                    Clicked="OnLoginClicked" 
                    BackgroundColor="#2196F3" 
                    TextColor="White" 
                    CornerRadius="8" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,20" />

            <Label Text="Ainda não tem uma conta?" 
                   HorizontalOptions="Center" 
                   TextColor="Gray"/>

            <Button Text="Quero Adotar (Adotante)" 
                    Clicked="OnIrParaCadastroAdotanteClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="#2196F3" 
                    BorderColor="#2196F3"
                    BorderWidth="1"
                    CornerRadius="8"/>

            <Button Text="Sou uma Instituição (ONG)" 
                    Clicked="OnIrParaCadastroOngClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="#4CAF50" 
                    BorderColor="#4CAF50"
                    BorderWidth="1"
                    CornerRadius="8"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>